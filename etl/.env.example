# Copia questo file in .env e compila la password.
#
# Stringa di connessione DIRETTA al Postgres di Supabase:
# Dashboard → Connect → Direct connection (porta 5432).
# Se la tua rete non ha IPv6 e la diretta non risponde, usa il
# "Session pooler" (sempre porta 5432): funziona con questi script.
# EVITA il "Transaction pooler" (porta 6543): rompe COPY e temp table.

DATABASE_URL=postgresql://postgres:LA-TUA-PASSWORD@db.TUO-PROGETTO.supabase.co:5432/postgres
