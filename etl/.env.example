# Copia questo file in .env e compila la password.
#
# Il database ora sta in casa: e' il Postgres del docker-compose in
# selfhost/, pubblicato solo su 127.0.0.1. L'ETL gira sulla stessa
# macchina e si collega come utente postgres, che puo' scrivere.
# (L'applicazione usa invece mappa_ro, di sola lettura.)

DATABASE_URL=postgres://postgres:LA-TUA-PASSWORD@localhost:5432/mappabilanci
